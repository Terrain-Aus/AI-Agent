# ─────────────────────────────────────────────────────────────
# TerrainPro Estimator — environment configuration
# Copy to `.env` and fill in. ALL of these are optional: with none
# set, the app runs fully offline (localStorage + on-device apprentice).
# ─────────────────────────────────────────────────────────────

# Supabase (cloud auth + quote sync). Leave blank for demo/local mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI provider for the Apprentice. Options: "claude" | "openai" | "" (local).
# When blank, the deterministic on-device apprentice is used.
VITE_AI_PROVIDER=
VITE_AI_API_KEY=
# Optional model override (defaults: claude-opus-4-8 / gpt-4o)
VITE_AI_MODEL=
