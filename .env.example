# ─────────────────────────────────────────────────────────────
# TerrainPro Estimator — environment configuration
# Copy to `.env` and fill in. ALL of these are optional: with none
# set, the app runs fully offline (localStorage + on-device apprentice).
# ─────────────────────────────────────────────────────────────

# ── AI Apprentice (server-side) ──────────────────────────────
# These are read ONLY by the server-side proxy (Vite plugin / Node).
# They are NOT prefixed with VITE_, so they are never bundled into the
# browser — your API key stays on the server.
#
# AI_PROVIDER: "openai" (default when a key is set) | "mock" | "local".
#   - openai → live streaming via the OpenAI Responses API
#   - mock   → deterministic offline apprentice (no key needed; for dev/tests)
#   - local  → disable the server brain; the client uses the on-device flow
AI_PROVIDER=openai
OPENAI_API_KEY=
# Optional model override (default: gpt-4o)
AI_MODEL=gpt-4o

# ── Supabase (cloud auth + quote sync) — optional ────────────
# Leave blank for demo/local mode. Exposed to the client (anon key only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
